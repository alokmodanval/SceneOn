# FriendsClub (by Tools4Genz) — Cloudflare Worker Backend URL (optional; leave empty for same-origin / Vite proxy)
VITE_BACKEND_URL=

# Optional Legacy Supabase Credentials (if using Supabase fallback instead of Cloudflare D1)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Toggle Cold-Start AI Personas (boolean only; API key stays server-side)
VITE_ENABLE_AI_PERSONAS=true

# Server-Only Groq API Key (Used by Cloudflare Pages Functions & local Vite dev middleware, never bundled to client)
GROQ_API_KEY=
