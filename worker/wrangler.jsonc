{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "chesschat-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://chesschat.tools4genz.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chesschat-db",
      "database_id": "fb32bc0f-6629-439f-9f46-152ddb56f116"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LOBBY_HUB",
        "class_name": "LobbyHub"
      },
      {
        "name": "ROOM_RELAY",
        "class_name": "RoomRelay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LobbyHub", "RoomRelay"]
    }
  ]
}
